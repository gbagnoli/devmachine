#!/usr/bin/env bash
set -euo pipefail

# This source-tree helper is reviewable, but must be installed read-only outside
# agent-writable roots before any enduring command-prefix approval is safe.
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
root="$(realpath -m "$script_dir/../runs")"
uri=qemu:///session
runtime_dir="/run/user/$(id -u)/skillet-test-libvirt"
backend=
vm_virsh() {
  if [[ "$backend" == flatpak ]]; then
    "$script_dir/virsh" -c "$uri" "$@"
  else
    env XDG_RUNTIME_DIR="$runtime_dir" /usr/bin/virsh -c "$uri" "$@"
  fi
}
select_backend() {
  if command -v virsh >/dev/null && command -v virtqemud >/dev/null && command -v virtstoraged >/dev/null; then
    backend=native
    if /usr/bin/virsh -c "$uri" uri >/dev/null 2>&1; then
      runtime_dir="/run/user/$(id -u)"
    fi
  elif flatpak info org.virt_manager.virt-manager >/dev/null 2>&1 &&
       flatpak info org.virt_manager.virt_manager.Extension.Qemu >/dev/null 2>&1; then
    backend=flatpak
    runtime_dir="/run/user/$(id -u)/skvm"
    export TEST_VM_LIBVIRT_RUNTIME_DIR="$runtime_dir"
    export PATH="$script_dir:$PATH"
  else
    echo 'Neither native libvirt nor Flatpak virt-manager is available.' >&2
    exit 1
  fi
}
runtime_from_manifest() {
  backend="$(config_value backend)"
  runtime_dir="$(config_value runtime_dir)"
  if [[ -z "$backend" && "$runtime_dir" == /run/user/"$(id -u)"/* ]]; then
    backend=native
  fi
  [[ "$backend" == native || "$backend" == flatpak ]] || { echo 'Invalid VM backend in manifest' >&2; exit 1; }
  if [[ "$backend" == flatpak ]]; then
    export TEST_VM_LIBVIRT_RUNTIME_DIR="$runtime_dir"
    export PATH="$script_dir:$PATH"
  fi
}
ensure_runtime() {
  if [[ "$backend" == native ]]; then
    ensure_native_runtime
  else
    if ! flatpak info org.virt_manager.virt-manager >/dev/null 2>&1 ||
       ! flatpak info org.virt_manager.virt_manager.Extension.Qemu >/dev/null 2>&1; then
      echo 'Flatpak virt-manager or its QEMU extension is unavailable' >&2; exit 1
    fi
    [[ "$runtime_dir" == "/run/user/$(id -u)/skvm" && ! -L "$runtime_dir" ]] || {
      echo 'Invalid Flatpak libvirt runtime path' >&2; exit 1;
    }
    install -d -m 0700 "$runtime_dir"
    if [[ ! -f "$runtime_dir/flatpak.pid" ]] || ! kill -0 "$(cat "$runtime_dir/flatpak.pid")" 2>/dev/null; then
      setsid "$script_dir/flatpak-virt" sh -c \
        'virtlogd --timeout 0 & virtstoraged --timeout 0 & virtqemud --timeout 0 & wait' \
        > "$runtime_dir/flatpak.log" 2>&1 < /dev/null &
      echo "$!" > "$runtime_dir/flatpak.pid"
    fi
    for ((attempt=0; attempt<20; attempt++)); do
      if [[ -S "$runtime_dir/libvirt/virtqemud-sock" && -S "$runtime_dir/libvirt/virtstoraged-sock" ]]; then
        break
      fi
      sleep 1
    done
    [[ -S "$runtime_dir/libvirt/virtqemud-sock" && -S "$runtime_dir/libvirt/virtstoraged-sock" ]] || {
      echo 'Flatpak libvirt daemons did not start' >&2
      tail -30 "$runtime_dir/flatpak.log" >&2
      exit 1
    }
  fi
}
ensure_native_runtime() {
  if [[ "$runtime_dir" == "/run/user/$(id -u)" ]]; then
    /usr/bin/virsh -c "$uri" uri >/dev/null || {
      echo "Cannot access the native user libvirt session at $uri" >&2; exit 1;
    }
    return
  fi
  [[ ! -L "$runtime_dir" ]] || { echo "Symlinked libvirt runtime refused" >&2; exit 1; }
  if [[ ! -d "$runtime_dir" ]]; then
    mkdir -m 0700 "$runtime_dir"
  fi
  if [[ ! -S "$runtime_dir/libvirt/virtqemud-sock" ]]; then
    env XDG_RUNTIME_DIR="$runtime_dir" /usr/bin/virtqemud --daemon --timeout 0
  fi
  if [[ ! -S "$runtime_dir/libvirt/virtstoraged-sock" ]]; then
    env XDG_RUNTIME_DIR="$runtime_dir" /usr/bin/virtstoraged --daemon --timeout 0
  fi
}
usage() {
  echo "Usage: $0 [HOST] list | $0 HOST create|ready|update|status|ssh|logs|reboot|destroy INSTANCE [--port PORT for create]" >&2
  exit 2
}
config_value() { sed -n "s/^$1=//p" "$run_dir/run.conf" | head -n 1; }
host_exists() {
  [[ -f "$script_dir/../$1.bu" || -f "$script_dir/../../skillet/crates/hosts/$1/Cargo.toml" ]]
}
host_available() {
  [[ -f "$script_dir/../$1.bu" && -f "$script_dir/../../skillet/crates/hosts/$1/Cargo.toml" ]]
}
list_host() {
  local listed_host="$1" availability=unavailable found=false listed_run listed_name listed_instance listed_state listed_port listed_runtime listed_backend recorded_uuid actual_uuid
  local -a listed_virsh
  if host_available "$listed_host"; then availability=available; fi
  for listed_run in "$root"/"$listed_host"-test-*/run.conf; do
    [[ -f "$listed_run" ]] || continue
    found=true
    run_dir="$(dirname "$listed_run")"
    listed_name="$(basename "$run_dir")"
    listed_instance="${listed_name#"$listed_host"-test-}"
    listed_state=invalid
    listed_port=-
    if [[ ! -L "$run_dir" && ! -L "$listed_run" && "$(config_value vm)" == "$listed_name" && "$(config_value host)" == "$listed_host" && "$(config_value uri)" == "$uri" ]]; then
      listed_port="$(config_value ssh_port)"
      listed_runtime="$(config_value runtime_dir)"
      listed_backend="$(config_value backend)"
      [[ -n "$listed_backend" ]] || listed_backend=native
      if [[ "$listed_port" =~ ^22[0-9][0-9]$ && -f "$run_dir/domain.uuid" && ( ( "$listed_backend" == flatpak && "$listed_runtime" == "/run/user/$(id -u)/skvm" ) || ( "$listed_backend" == native && ( "$listed_runtime" == "/run/user/$(id -u)" || "$listed_runtime" == /run/user/"$(id -u)"/* ) ) ) ]]; then
        recorded_uuid="$(cat "$run_dir/domain.uuid")"
        if [[ "$listed_backend" == flatpak ]]; then
          listed_virsh=(env TEST_VM_LIBVIRT_RUNTIME_DIR="$listed_runtime" "$script_dir/virsh")
        else
          listed_virsh=(env XDG_RUNTIME_DIR="$listed_runtime" /usr/bin/virsh)
        fi
        if [[ "$recorded_uuid" =~ ^[0-9a-f-]{36}$ ]] && actual_uuid="$("${listed_virsh[@]}" -c "$uri" domuuid "$listed_name" 2>/dev/null)"; then
          if [[ "$actual_uuid" == "$recorded_uuid" ]]; then
            listed_state="$("${listed_virsh[@]}" -c "$uri" domstate "$listed_name" 2>/dev/null)" || listed_state=unknown
          else
            listed_state=mismatch
          fi
        else
          listed_state=missing
        fi
      fi
    fi
    printf '%-12s %-12s %-16s %-12s %s\n' "$listed_host" "$availability" "$listed_instance" "$listed_state" "$listed_port"
  done
  if [[ "$found" == false ]]; then
    printf '%-12s %-12s %-16s %-12s %s\n' "$listed_host" "$availability" - none -
  fi
}
list_header() { printf '%-12s %-12s %-16s %-12s %s\n' HOST TEMPLATE INSTANCE STATE PORT; }

if (($# == 1)) && [[ "$1" == list ]]; then
  [[ ! -L "$root" ]] || { echo "Symlinked artifact root refused" >&2; exit 1; }
  mapfile -t hosts < <(
    {
      for candidate in "$script_dir"/../*.bu; do
        if [[ -f "$candidate" ]]; then basename "$candidate" .bu; fi
      done
      for candidate in "$script_dir"/../../skillet/crates/hosts/*/Cargo.toml; do
        if [[ -f "$candidate" ]]; then basename "$(dirname "$candidate")"; fi
      done
    } | sort -u
  )
  list_header
  for candidate in "${hosts[@]}"; do list_host "$candidate"; done
  exit 0
fi
(($# >= 2)) || usage
host="$1"
operation="$2"
shift 2
if [[ ! "$host" =~ ^[a-z][a-z0-9-]*$ ]] || ! host_exists "$host"; then
  echo "Unknown host: $host" >&2
  exit 2
fi
if [[ "$operation" == list ]]; then
  (($# == 0)) || usage
  [[ ! -L "$root" ]] || { echo "Symlinked artifact root refused" >&2; exit 1; }
  list_header
  list_host "$host"
  exit 0
fi
(($# >= 1)) || usage
instance="$1"
shift
[[ "$instance" =~ ^[a-z0-9][a-z0-9-]*$ ]] || usage
name="$host-test-$instance"
run_dir="$root/$name"
[[ ! -L "$root" && ! -L "$run_dir" ]] || { echo "Symlinked artifact path refused" >&2; exit 1; }
inspect_owned() {
  [[ -d "$run_dir" && -f "$run_dir/run.conf" && -f "$run_dir/domain.uuid" ]] || {
    echo "Missing owned run manifest for $name" >&2; exit 1;
  }
  [[ "$(realpath -e "$run_dir")" == "$run_dir" ]] || { echo "Artifact path escapes root" >&2; exit 1; }
  [[ "$(config_value vm)" == "$name" && "$(config_value host)" == "$host" && "$(config_value uri)" == "$uri" ]] || {
    echo "Run manifest does not match requested domain" >&2; exit 1;
  }
  runtime_from_manifest
  if [[ "$backend" == native ]]; then
    [[ "$runtime_dir" == "/run/user/$(id -u)" || "$runtime_dir" == /run/user/"$(id -u)"/* ]] || { echo "Invalid recorded libvirt runtime" >&2; exit 1; }
  else
    [[ "$runtime_dir" == "/run/user/$(id -u)/skvm" ]] || { echo "Invalid Flatpak runtime" >&2; exit 1; }
  fi
  ensure_runtime
  actual_uuid="$(vm_virsh domuuid "$name")"
  [[ "$actual_uuid" == "$(cat "$run_dir/domain.uuid")" ]] || { echo "Domain UUID mismatch" >&2; exit 1; }
  disk="$run_dir/$name.qcow2"
  [[ -f "$disk" && ! -L "$disk" ]] || { echo "Expected test disk is missing or symlinked" >&2; exit 1; }
  ignition="$run_dir/ignition/$host.ign"
  [[ -f "$ignition" && ! -L "$ignition" ]] || { echo "Expected Ignition file is missing or symlinked" >&2; exit 1; }
  mapfile -t disks < <(vm_virsh domblklist "$name" --details | awk '$2 == "disk" {print $4}')
  [[ "${#disks[@]}" -eq 2 && "${disks[0]}" == "$disk" && "${disks[1]}" == "$ignition" ]] || {
    echo "Domain disks do not match test artifacts" >&2; exit 1;
  }
  port="$(config_value ssh_port)"
  [[ "$port" =~ ^22[0-9][0-9]$ ]] || { echo "Invalid recorded port" >&2; exit 1; }
}
ssh_args() {
  args=(-i "$run_dir/ssh/id_ed25519" -p "$port" -o BatchMode=yes
    -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new
    -o UserKnownHostsFile="$run_dir/ssh/known_hosts")
}
case "$operation" in
  create)
    if (($# == 0)); then
      port=2201
    elif (($# == 2)) && [[ "$1" == --port ]]; then
      port="$2"
    else
      usage
    fi
    [[ "$port" =~ ^22[0-9][0-9]$ ]] || { echo "Use a port from 2200 to 2299" >&2; exit 2; }
    [[ ! -e "$run_dir" && ! -L "$run_dir" ]] || { echo "Run path already exists" >&2; exit 1; }
    host_available "$host" || { echo "Host $host needs both $host.bu and a skillet-$host crate" >&2; exit 1; }
    select_backend
    if [[ "$backend" == native ]]; then
      command -v passt >/dev/null || { echo 'Missing native VM tool: passt' >&2; exit 1; }
      if ! command -v python3 >/dev/null || ! command -v xmllint >/dev/null ||
         ! command -v virt-xml-validate >/dev/null; then
        echo 'Native VM creation needs python3, xmllint and virt-xml-validate' >&2; exit 1
      fi
    fi
    if [[ ! -e /dev/kvm ]]; then
      echo '/dev/kvm is unavailable; enable hardware virtualization and KVM before creating a VM.' >&2
      exit 1
    fi
    ensure_runtime
    if vm_virsh dominfo "$name" &>/dev/null; then
      echo "Domain already exists" >&2; exit 1
    fi
    mkdir -p "$root"
    TEST_VM_BACKEND="$backend" TEST_VM_LIBVIRT_RUNTIME_DIR="$runtime_dir" "$script_dir/coreos-install" --name "$name" --output-dir "$run_dir" \
      --ssh-port "$port" --libvirt-uri "$uri" "$script_dir/../$host.bu"
    vm_virsh domuuid "$name" > "$run_dir/domain.uuid"
    echo "Run: $run_dir" ;;
  ready)
    (($# == 0)) || usage
    inspect_owned
    "$script_dir/test-vm-ready" "$run_dir" ;;
  update)
    (($# == 0)) || usage
    inspect_owned
    artifact_target_dir="${CARGO_TARGET_DIR:-$script_dir/../../skillet/target}"
    if [[ "$artifact_target_dir" != /* ]]; then
      artifact_target_dir="$script_dir/../../skillet/$artifact_target_dir"
    fi
    artifact="$(realpath -e "$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet-$host")"
    generic_artifact="$(realpath -e "$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet")"
    [[ -f "$artifact" && ! -L "$artifact" && -f "$generic_artifact" && ! -L "$generic_artifact" ]] || { echo "Build skillet and skillet-$host first" >&2; exit 1; }
    ssh_args
    scp -O -i "$run_dir/ssh/id_ed25519" -P "$port" -o BatchMode=yes \
      -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$run_dir/ssh/known_hosts" \
      "$artifact" giacomo@127.0.0.1:/var/tmp/skillet-update
    scp -O -i "$run_dir/ssh/id_ed25519" -P "$port" -o BatchMode=yes \
      -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$run_dir/ssh/known_hosts" \
      "$generic_artifact" giacomo@127.0.0.1:/var/tmp/skillet-generic-update
    # shellcheck disable=SC2029
    ssh "${args[@]}" giacomo@127.0.0.1 \
      "sudo -n install -m 0755 /var/tmp/skillet-update /var/usrlocal/bin/skillet-$host && sudo -n install -m 0755 /var/tmp/skillet-generic-update /var/usrlocal/bin/skillet && rm -f /var/tmp/skillet-update /var/tmp/skillet-generic-update"
    sha256sum "$artifact" > "$run_dir/deployed-skillet.sha256"
    sha256sum "$generic_artifact" > "$run_dir/deployed-skillet-generic.sha256"
    echo "Updated skillet and skillet-$host in $name" ;;
  status)
    (($# == 0)) || usage
    inspect_owned
    vm_virsh dominfo "$name"
    vm_virsh domblklist "$name" ;;
  ssh)
    (($# == 0)) || usage
    inspect_owned
    ssh_args
    exec ssh "${args[@]}" giacomo@127.0.0.1 ;;
  logs)
    (($# == 0)) || usage
    inspect_owned
    ssh_args
    ssh "${args[@]}" giacomo@127.0.0.1 \
      'sudo -n rpm-ostree status; sudo -n journalctl -b -u ucore-bootstrap.service -u skillet-apply.service --no-pager -n 200' ;;
  reboot)
    (($# == 0)) || usage
    inspect_owned
    vm_virsh reboot "$name" ;;
  destroy)
    (($# == 0)) || usage
    inspect_owned
    if [[ "$(vm_virsh domstate "$name")" != 'shut off' ]]; then
      vm_virsh destroy "$name"
    fi
    vm_virsh undefine "$name"
    [[ "$(realpath -e "$run_dir")" == "$run_dir" && "$run_dir" == "$root"/"$host"-test-* ]] || exit 1
    rm -rf -- "$run_dir" ;;
  *) usage ;;
esac
