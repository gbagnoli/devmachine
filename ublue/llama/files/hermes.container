[Unit]
Description=Hermes Agent Service
After=llama-server.service llama-network.service
Requires=llama-server.service llama-network.service
BindsTo=llama-server.service llama-network.service

[Container]
ContainerName=hermes
Image=docker.io/nousresearch/hermes-agent:latest
Exec=gateway run
Volume=%h/.config/hermes:/opt/data:Z
Environment=API_SERVER_ENABLED=1
Environment=API_SERVER_HOST=0.0.0.0
Environment=API_SERVER_CORS_ORIGINS=*
Secret=hermes_api_server_key,type=env,target=API_SERVER_KEY
Environment=HERMES_DASHBOARDS=1
Environment=HERMES_DASHBOARD_HOST=127.0.0.1
Environment=HERMES_UID=1000
Environment=HERMES_GID=1000
UserNS=keep-id
Network=llama.network

[Install]
WantedBy=default.target
