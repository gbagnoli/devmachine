FROM docker.io/library/rust:1.100-alpine AS build
RUN apk add --no-cache build-base
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
RUN cargo build --locked --release --target x86_64-unknown-linux-musl -p skillet-unifi-ready

FROM scratch
LABEL org.opencontainers.image.source="https://github.com/gbagnoli/devmachine"
COPY --from=build /src/target/x86_64-unknown-linux-musl/release/skillet-unifi-ready /skillet-unifi-ready
USER 65532:65532
ENTRYPOINT ["/skillet-unifi-ready"]
