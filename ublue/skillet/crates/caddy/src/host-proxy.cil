; Dedicated Unix-to-loopback relay; ordinary containers gain no host daemon access.
(type skillet_ui_host_t)
(typeattributeset domain (skillet_ui_host_t))
(roletype system_r skillet_ui_host_t)
(allow init_t skillet_ui_host_t (process (transition)))
(allow init_t skillet_ui_host_t (process2 (nnp_transition nosuid_transition)))
(allow skillet_ui_host_t bin_t (file (entrypoint execute read open getattr map)))
(allow skillet_ui_host_t self (process (fork getrlimit setrlimit sigchld signal sigkill signull getcap getattr)))
(allow skillet_ui_host_t self (unix_stream_socket (create read write ioctl bind listen accept connect getopt setopt shutdown getattr recvfrom sendto)))
(allow skillet_ui_host_t self (tcp_socket (create read write ioctl connect getopt setopt shutdown getattr recvfrom sendto)))
(allow skillet_ui_host_t port_type (tcp_socket (name_connect)))
(allow skillet_ui_host_t node_type (node (tcp_send tcp_recv)))
(allow skillet_ui_host_t netif_type (netif (tcp_send tcp_recv)))
(allow skillet_ui_host_t init_t (fd (use)))
(allow skillet_ui_host_t init_t (fifo_file (read write append getattr ioctl)))
(allow skillet_ui_host_t var_run_t (dir (search getattr write add_name remove_name)))
(allow skillet_ui_host_t var_run_t (sock_file (create read write getattr setattr unlink)))
(allow skillet_ui_host_t container_file_t (dir (search getattr write add_name remove_name)))
(allow skillet_ui_host_t container_file_t (sock_file (create read write getattr setattr unlink)))
(allow container_t skillet_ui_host_t (unix_stream_socket (connectto)))
