; Only this filtering broker can reach the host bus. Containers retain their
; normal confinement and receive only org.bluez through a private mounted socket.
(type skillet_ha_bluetooth_t)
(typeattributeset domain (skillet_ha_bluetooth_t))
(roletype system_r skillet_ha_bluetooth_t)
(allow init_t skillet_ha_bluetooth_t (process (transition)))
(allow init_t skillet_ha_bluetooth_t (process2 (nnp_transition nosuid_transition)))
(allow skillet_ha_bluetooth_t bin_t (file (entrypoint execute execute_no_trans read open getattr map)))
(allow skillet_ha_bluetooth_t shell_exec_t (file (entrypoint execute execute_no_trans read open getattr map)))
(allow skillet_ha_bluetooth_t lib_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t lib_t (file (execute read open getattr map)))
(allow skillet_ha_bluetooth_t lib_t (lnk_file (read getattr)))
(allow skillet_ha_bluetooth_t ld_so_t (file (execute read open getattr map)))
(allow skillet_ha_bluetooth_t ld_so_cache_t (file (read open getattr map)))
(allow skillet_ha_bluetooth_t usr_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t etc_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t etc_t (file (read open getattr map)))
(allow skillet_ha_bluetooth_t device_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t null_device_t (chr_file (read write open getattr ioctl)))
(allow skillet_ha_bluetooth_t self (process (fork getrlimit setrlimit sigchld signal sigkill signull getcap getattr)))
(allow skillet_ha_bluetooth_t self (unix_stream_socket (create read write ioctl bind listen accept connect getopt setopt shutdown getattr recvfrom sendto)))
(allow skillet_ha_bluetooth_t init_t (fd (use)))
(allow skillet_ha_bluetooth_t init_t (fifo_file (read write append getattr ioctl)))
(allow skillet_ha_bluetooth_t var_run_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t container_file_t (dir (search getattr write add_name remove_name)))
(allow skillet_ha_bluetooth_t container_file_t (sock_file (create read write getattr setattr unlink)))
(allow container_t skillet_ha_bluetooth_t (unix_stream_socket (connectto)))
(allow skillet_ha_bluetooth_t system_dbusd_var_run_t (dir (search getattr)))
(allow skillet_ha_bluetooth_t system_dbusd_var_run_t (sock_file (write getattr)))
(allow skillet_ha_bluetooth_t system_dbusd_t (unix_stream_socket (connectto)))
(allow skillet_ha_bluetooth_t system_dbusd_t (dbus (send_msg)))
(allow system_dbusd_t skillet_ha_bluetooth_t (dbus (send_msg)))
(allow skillet_ha_bluetooth_t bluetooth_t (dbus (send_msg)))
(allow bluetooth_t skillet_ha_bluetooth_t (dbus (send_msg)))
