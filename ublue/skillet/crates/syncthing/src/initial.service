[Unit]
Description=Initialize missing Syncthing configuration
After=local-fs.target skillet-apply.service
Before=syncthing.service
RequiresMountsFor=/var/lib/data
ConditionPathExists=/etc/credstore.encrypted/skillet/syncthing_initial.cred

[Service]
Type=oneshot
LoadCredentialEncrypted=syncthing_initial:/etc/credstore.encrypted/skillet/syncthing_initial.cred
ExecStart=/var/usrlocal/bin/skillet syncthing initialize --host-file /etc/skillet/host
TimeoutStartSec=120
