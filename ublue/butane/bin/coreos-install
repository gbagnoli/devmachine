#!/usr/bin/env bash
set -euo pipefail

script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
butane_dir="$(realpath "$script_dir/..")"
repo_dir="$(realpath "$butane_dir/..")"

usage() {
  cat <<USAGE
Usage: $0 --name HOST-test-INSTANCE [--output-dir DIR] [--ssh-port PORT] [--artifact FILE] [--image FILE] [--libvirt-uri URI] --uuid UUID --resume-prepared CONFIG.bu

Creation must start through test-vm so a matching Preparing manifest exists.
Generated keys, Ignition, logs and disk are kept in butane/runs/NAME.
USAGE
}

vm_name=
output_dir=
ssh_port=2222
artifact=
generic_artifact=
custom_artifact=false
image=
libvirt_uri=qemu:///session
vm_uuid=
resume_prepared=false
vm_command() {
  if [[ -n "${TEST_VM_LIBVIRT_RUNTIME_DIR:-}" && "${TEST_VM_BACKEND:-native}" == native ]]; then
    env XDG_RUNTIME_DIR="$TEST_VM_LIBVIRT_RUNTIME_DIR" "$@"
  else
    "$@"
  fi
}
skillet_cli() {
  if [[ -n "${SKILLET_BINARY:-}" ]]; then
    "$SKILLET_BINARY" "$@"
  else
    (cd "$repo_dir/skillet" && cargo run --quiet --release -p skillet -- "$@")
  fi
}
while (($#)); do
  case "$1" in
    --name|--output-dir|--ssh-port|--artifact|--image|--libvirt-uri|--uuid)
      (($# >= 2)) || { usage >&2; exit 2; }
      case "$1" in
        --name) vm_name="$2" ;;
        --output-dir) output_dir="$2" ;;
        --ssh-port) ssh_port="$2" ;;
        --artifact) artifact="$2"; custom_artifact=true ;;
        --image) image="$2" ;;
        --libvirt-uri) libvirt_uri="$2" ;;
        --uuid) vm_uuid="$2" ;;
      esac
      shift 2 ;;
    --resume-prepared) resume_prepared=true; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) usage >&2; exit 2 ;;
    *) break ;;
  esac
done
(($# == 1)) && [[ "$1" == *.bu && -f "$1" ]] || { usage >&2; exit 2; }
input="$(realpath "$1")"
host="$(basename "$input" .bu)"
[[ "$host" =~ ^[a-z][a-z0-9-]*$ && "$input" == "$butane_dir/$host.bu" ]] || { echo "Use a host Butane file from $butane_dir" >&2; exit 2; }
vm_name="${vm_name:-$host}"
[[ "$vm_name" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || { echo "Invalid VM name" >&2; exit 2; }
[[ "$vm_name" == "$host-test-"* ]] || {
  echo "VM name must match the recorded host-test-instance identity" >&2; exit 2;
}
instance="${vm_name#"$host-test-"}"
if [[ ! "$ssh_port" =~ ^[0-9]+$ ]] || ((ssh_port < 1024 || ssh_port > 65535)); then
  echo "Invalid SSH port" >&2
  exit 2
fi
output_dir="$(realpath -m "${output_dir:-$butane_dir/runs/$vm_name}")"
if [[ "$resume_prepared" == true ]]; then
  [[ "$output_dir" == "$butane_dir/runs/$vm_name" && -f "$output_dir/vm.json" ]] || {
    echo "Prepared VM output must be its recorded run directory" >&2; exit 1;
  }
  [[ "$vm_uuid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || {
    echo "A valid recorded UUID is required for prepared VM creation" >&2; exit 2;
  }
else
  [[ -z "$vm_uuid" ]] || { echo "--uuid requires --resume-prepared" >&2; exit 2; }
fi
vm_command virsh -c "$libvirt_uri" uri >/dev/null || { echo "Cannot access libvirt URI $libvirt_uri" >&2; exit 1; }
command -v passt >/dev/null || { echo "passt is required for loopback SSH forwarding" >&2; exit 1; }
if vm_command virsh -c "$libvirt_uri" dominfo "$vm_name" &>/dev/null; then
  echo "Refusing existing libvirt domain $vm_name on $libvirt_uri" >&2
  exit 1
fi
if [[ -e "$output_dir" && "$resume_prepared" != true || -L "$output_dir" ]]; then
  echo "Refusing existing output path $output_dir" >&2
  exit 1
fi
if [[ -z "$artifact" ]]; then
  artifact_target_dir="${CARGO_TARGET_DIR:-$repo_dir/skillet/target}"
  if [[ "$artifact_target_dir" != /* ]]; then
    artifact_target_dir="$repo_dir/skillet/$artifact_target_dir"
  fi
  artifact="$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet-$host"
  generic_artifact="$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet"
  (cd "$repo_dir/skillet" && cargo build --release --target x86_64-unknown-linux-musl -p skillet -p "skillet-$host")
fi
[[ -f "$artifact" ]] || { echo "Missing Skillet artifact: $artifact" >&2; exit 1; }
artifact="$(realpath "$artifact")"
if [[ -z "$generic_artifact" ]]; then
  artifact_target_dir="${CARGO_TARGET_DIR:-$repo_dir/skillet/target}"
  if [[ "$artifact_target_dir" != /* ]]; then artifact_target_dir="$repo_dir/skillet/$artifact_target_dir"; fi
  generic_artifact="$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet"
fi
if [[ "$custom_artifact" == true || ! -f "$generic_artifact" ]]; then
  (cd "$repo_dir/skillet" && cargo build --release --target x86_64-unknown-linux-musl -p skillet)
fi
[[ -f "$generic_artifact" ]] || { echo "Missing generic Skillet artifact: $generic_artifact" >&2; exit 1; }
generic_artifact="$(realpath "$generic_artifact")"
if [[ -z "$image" ]]; then
  mapfile -t images < <(find "$butane_dir/images" -maxdepth 1 -name 'fedora-coreos-*-qemu.x86_64.qcow2' -type f 2>/dev/null | sort)
  if ((${#images[@]} == 0)); then
    mkdir -p "$butane_dir/images"
    podman run --pull=always --rm --security-opt label=disable \
      -v "$butane_dir/images:/data" -w /data \
      quay.io/coreos/coreos-installer:release \
      download -s stable -p qemu -f qcow2.xz --decompress
    mapfile -t images < <(find "$butane_dir/images" -maxdepth 1 -name 'fedora-coreos-*-qemu.x86_64.qcow2' -type f | sort)
  fi
  ((${#images[@]} == 1)) || { echo "Specify --image: found ${#images[@]} candidate FCOS images" >&2; exit 1; }
  image="${images[0]}"
fi
[[ -f "$image" ]] || { echo "Missing FCOS image: $image" >&2; exit 1; }
image="$(realpath "$image")"
instance="${vm_name#"$host-test-"}"
skillet_cli test vm prepare-local "$host" "$instance" --image "$image" >/dev/null
skillet_cli test vm stage-local "$host" "$instance" \
  --image "$image" --host-binary "$artifact" --generic-binary "$generic_artifact"
# Keep the multi-megabyte static binary out of QEMU fw_cfg. Ignition reads
# fw_cfg very slowly for large configs; test-vm-ready installs the artifacts
# over SSH after the guest has completed its first Ignition boot.
ignition="$("$script_dir/butane" -s -o "$output_dir/ignition" "$output_dir/source/$host.bu" "$host.ign")"
ignition_bytes="$(stat -c '%s' "$ignition")"
if ((ignition_bytes > 1048576)); then
  echo "Warning: Ignition config is ${ignition_bytes} bytes; large QEMU fw_cfg configs can take a long time to read" >&2
fi
if [[ "${TEST_VM_BACKEND:-native}" == flatpak ]]; then
  {
    virt-install --version
    vm_command virsh --version
    podman --version
    yq --version
  } > "$output_dir/tool-versions.txt"
else
  skillet_cli test vm create-native "$host" "$instance"
fi

if [[ "${TEST_VM_BACKEND:-native}" == flatpak ]]; then
  network=none
  qemu_commandline="-fw_cfg name=opt/com.coreos/config,file=$ignition -netdev user,id=skilletnet,hostfwd=tcp:127.0.0.1:$ssh_port-:22 -device virtio-net-pci,netdev=skilletnet,bus=pcie.0,addr=0x1d"
  uuid_args=()
  [[ -z "$vm_uuid" ]] || uuid_args=(--uuid "$vm_uuid")
  printf '%s\n' "$vm_uuid" > "$output_dir/domain.uuid.tmp"
  chmod 600 "$output_dir/domain.uuid.tmp"
  mv -f "$output_dir/domain.uuid.tmp" "$output_dir/domain.uuid"
  echo "Creating $vm_name on $libvirt_uri, disk $output_dir/$vm_name.qcow2, SSH 127.0.0.1:$ssh_port" >&2
  vm_command virt-install --connect "$libvirt_uri" --name "$vm_name" "${uuid_args[@]}" \
    --osinfo linux2024 --memory 8192 --vcpus 2 --import \
    --disk "path=$output_dir/$vm_name.qcow2,format=qcow2,bus=virtio" \
    --disk "path=$ignition,format=raw,bus=virtio,readonly=on" \
    --network "$network" --graphics none \
    --console pty,target_type=serial --noautoconsole \
    --qemu-commandline="$qemu_commandline"
else
  [[ "${TEST_VM_BACKEND:-native}" == native ]] || { echo 'Flatpak backend needs virt-install' >&2; exit 1; }
fi
