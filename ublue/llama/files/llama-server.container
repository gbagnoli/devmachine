[Unit]
Description=Llama.cpp Server
DefaultDependencies=yes
After=llama-network.service
Requires=llama-network.service
BindsTo=llama-network.service

[Container]
Image=ghcr.io/ggml-org/llama.cpp:server-cuda
ContainerName=llama-server
# Hardware and Security
Annotation=run.oci.handler=nvidia
AddDevice=nvidia.com/gpu=all
GroupAdd=keep-groups
SecurityLabelDisable=true
# Environment
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=compute,utility
Network=llama.network
Volume=%h/.cache/huggingface:/root/.cache/huggingface:z
Volume=%h/.config/llama-server/models.ini:/root/models.ini:ro,z
Exec= --port 8000 --host 0.0.0.0 --models-preset /root/models.ini --models-max 1


# Healthcheck: Checks if port 8000 is accepting connections
# It runs every 30s after an initial 60s warm-up
HealthCmd=curl -f http://localhost:8000/health || exit 1
HealthInterval=30s
HealthStartPeriod=60s

# makes systemd wait until the Healthcheck passes
# before marking the unit as 'Started'
Notify=all

[Service]
# Increase timeout because loading a 25GB model takes time
TimeoutStartSec=600

[Install]
# Start on boot
WantedBy=default.target
