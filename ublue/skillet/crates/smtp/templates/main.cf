# Managed by Skillet. Local submission only; no destination-MX fallback.
compatibility_level = 3.6
queue_directory = /var/spool/postfix
inet_interfaces = loopback-only
inet_protocols = all
myhostname = {{ hostname }}
myorigin = $myhostname
mydestination =
mynetworks = 127.0.0.0/8 [::1]/128
relay_domains =
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = permit_mynetworks, reject
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_helo_required = yes
disable_vrfy_command = yes
relayhost = {{ relay }}
smtp_fallback_relay =
default_transport = smtp
relay_transport = smtp
local_transport = error:5.1.1 Local delivery disabled
alias_maps =
alias_database =
smtp_sasl_auth_enable = {{ auth }}
smtp_sasl_password_maps = {{ password_map }}
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous
smtp_tls_security_level = {{ tls }}
smtp_tls_CAfile = /etc/pki/tls/certs/ca-bundle.crt
smtp_tls_secure_cert_match = nexthop
smtp_tls_wrappermode = no
sender_canonical_classes = envelope_sender, header_sender
sender_canonical_maps = {{ sender_map }}
