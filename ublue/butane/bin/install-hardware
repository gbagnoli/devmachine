#!/usr/bin/env bash
# Runs only in the prepared Fedora CoreOS live environment, never during apply.
set -euo pipefail

mok_is_enrolled() {
  local certificate="$1" output status=0
  [[ -f "$certificate" ]] || return 1
  output="$(LC_ALL=C mokutil --test-key "$certificate" 2>&1)" || status=$?
  # Live-image versions differ in their exit status. Require the explicit
  # enrolled result too: pending requests and blocked keys are not trusted.
  case "$status:$output" in
    "0:$certificate is already enrolled"|"1:$certificate is already enrolled") return 0 ;;
    *) printf '%s\n' "$output" >&2; return 1 ;;
  esac
}

disk_confirmation_matches() {
  local prepared_disk="$1" resolved_disk="$2" confirmation="$3"
  [[ -n "$confirmation" && ( "$confirmation" == "$prepared_disk" || "$confirmation" == "${resolved_disk##*/}" ) ]]
}

verify_installed_root() {
  local selected_disk="$1" layout path kind label root="" filesystem filesystem_label
  layout="$(lsblk --list --noheadings --paths --output PATH,TYPE,PARTLABEL "$selected_disk")" || return 1
  while read -r path kind label; do
    if [[ "$kind" == part && "$label" == root ]]; then
      [[ -z "$root" ]] || { echo 'Multiple installed root partitions; refusing to report success.' >&2; return 1; }
      root="$path"
    fi
  done <<< "$layout"
  [[ -n "$root" ]] || { echo 'Installed root partition is absent.' >&2; return 1; }
  filesystem="$(blkid --probe --match-tag TYPE --output value "$root")" || return 1
  filesystem_label="$(blkid --probe --match-tag LABEL --output value "$root")" || return 1
  case "$filesystem:$filesystem_label" in
    xfs:root|ext4:root|btrfs:root)
      printf 'Verified initial Fedora root: %s TYPE=%s LABEL=%s\n' "$root" "$filesystem" "$filesystem_label"
      ;;
    *)
      echo "Installed root is not the expected initial Fedora filesystem: TYPE=$filesystem LABEL=$filesystem_label" >&2
      echo 'Do not reboot. Retain the installer output and inspect the selected disk.' >&2
      return 1
      ;;
  esac
}

[[ $EUID -eq 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
[[ $# -le 1 ]] || { echo 'Usage: skillet-install /path/to/destination.ign' >&2; exit 2; }
config="${1:-/etc/skillet-install/config.ign}"
[[ -f "$config" ]] || { echo 'Transfer the prepared destination Ignition file and pass its path.' >&2; exit 1; }
umask 077
staged_config="$(mktemp /run/skillet-install.XXXXXXXX.ign)"
trap 'rm -f -- "$staged_config"' EXIT
cp -- "$config" "$staged_config"
actual_hash="$(sha256sum "$staged_config" | cut -d ' ' -f 1)"
[[ "$actual_hash" == "$(cat /etc/skillet-install/ignition.sha256)" ]] || {
  echo 'Ignition checksum does not match this prepared USB; refusing installation.' >&2; exit 1;
}
disk="$(cat /etc/skillet-install/disk)"
profile="$(cat /etc/skillet-install/profile)"
[[ "$disk" == /dev/disk/by-id/* && "$disk" != *-part* && -b "$disk" ]] || {
  echo 'Prepared whole-disk identifier is absent; stop and inspect hardware.' >&2; exit 1;
}
[[ "$(lsblk -dn -o TYPE "$disk")" == disk ]] || { echo 'Target is not a whole disk.' >&2; exit 1; }
[[ "$profile" == tpm || "$profile" == unencrypted ]] || { echo 'Invalid root profile.' >&2; exit 1; }
secure_boot=disabled
if [[ -d /sys/firmware/efi ]]; then
  secure_boot="$(mokutil --sb-state)" || { echo 'Cannot establish Secure Boot state.' >&2; exit 1; }
fi
case "$secure_boot" in
  'SecureBoot enabled'|'SecureBoot disabled'|disabled) ;;
  *) echo 'Unrecognized Secure Boot state; stop and inspect firmware.' >&2; exit 1 ;;
esac
if [[ "$profile" == tpm ]]; then
  [[ -d /sys/firmware/efi && "$(cat /sys/class/tpm/tpm0/tpm_version_major)" == 2 ]] || {
    echo 'TPM profile requires UEFI and TPM 2.' >&2; exit 1;
  }
  [[ "$secure_boot" == 'SecureBoot enabled' ]] || {
    echo 'Enable Secure Boot before installation; no unencrypted fallback.' >&2; exit 1;
  }
fi
if [[ "$secure_boot" == 'SecureBoot enabled' ]]; then
  if ! mok_is_enrolled /etc/skillet-install/ublue.der; then
    echo 'Enroll the supplied ublue MOK, reboot back into this USB, then retry.' >&2
    echo 'Enrollment command: sudo mokutil --import /etc/skillet-install/ublue.der' >&2
    exit 1
  fi
fi
lsblk -o NAME,SIZE,MODEL,SERIAL,TYPE,MOUNTPOINTS "$disk"
if lsblk -nr -o MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then
  echo 'Target has mounted filesystems; stop and inspect before installation.' >&2; exit 1
fi
resolved_disk="$(readlink -f -- "$disk")"
[[ "$resolved_disk" == /dev/* && -b "$resolved_disk" ]] || { echo 'Cannot resolve the prepared disk.' >&2; exit 1; }
disk_name="${resolved_disk##*/}"
echo "Installation will erase $disk ($disk_name). Root profile: $profile"
printf 'Type the disk name (example: %s) or the complete prepared identifier to ERASE it: ' "$disk_name"
read -r confirmation </dev/tty
disk_confirmation_matches "$disk" "$resolved_disk" "$confirmation" || { echo 'Cancelled.' >&2; exit 1; }
[[ -b "$disk" && "$(readlink -f -- "$disk")" == "$resolved_disk" ]] || {
  echo 'Prepared disk changed during confirmation; refusing installation.' >&2; exit 1;
}
coreos-installer install "$disk" --ignition-file "$staged_config"
udevadm settle
[[ -b "$disk" && "$(readlink -f -- "$disk")" == "$resolved_disk" ]] || {
  echo 'Prepared disk changed during installation; refusing to report success.' >&2; exit 1;
}
verify_installed_root "$disk"
echo 'Installed. Remove the USB before booting the installed system.'
