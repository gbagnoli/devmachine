#!/usr/bin/env bash
set -euo pipefail

# Compatibility command surface. VM lifecycle policy and implementation live
# in the Rust CLI; this script only translates the long-standing argument form.
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
repo_dir="$(realpath "$script_dir/../..")"

usage() {
  echo "Usage: $0 [HOST] list | $0 HOST create|ready|update|status|ssh|logs|reboot|destroy INSTANCE [--port PORT] [--image IMAGE]" >&2
  exit 2
}

skillet_cli() {
  if [[ -n "${SKILLET_BINARY:-}" ]]; then
    exec "$SKILLET_BINARY" "$@"
  fi
  cd "$repo_dir/skillet"
  exec cargo run --quiet --release -p skillet -- "$@"
}

if (($# == 1)) && [[ "$1" == list ]]; then
  skillet_cli test vm list
fi
if (($# == 2)) && [[ "$2" == list ]]; then
  skillet_cli test vm list "$1"
fi
(($# >= 3)) || usage
host="$1"
operation="$2"
instance="$3"
shift 3

case "$operation" in
  create)
    args=(test vm create "$host" "$instance")
    while (($#)); do
      case "$1" in
        --port|--image)
          (($# >= 2)) || usage
          args+=("$1" "$2")
          shift 2
          ;;
        *) usage ;;
      esac
    done
    skillet_cli "${args[@]}"
    ;;
  ready|update|status|ssh|logs|reboot|destroy)
    (($# == 0)) || usage
    skillet_cli test vm "$operation" "$host" "$instance"
    ;;
  *) usage ;;
esac
