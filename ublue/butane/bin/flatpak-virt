#!/usr/bin/env bash
set -euo pipefail

(($# >= 1)) || { echo "Usage: $0 COMMAND [ARG...]" >&2; exit 2; }
script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../lib/utils.sh
source "$(realpath "$script_dir/../../lib/utils.sh")"

flatpak_args=(--filesystem=host --filesystem="$(realpath "$script_dir/..")"
  --env=PATH=/app/bin:/usr/bin:/app/lib/extensions/bin:/run/host/usr/bin)
if [[ -n "${TEST_VM_LIBVIRT_RUNTIME_DIR:-}" ]]; then
  flatpak_args+=(--filesystem=xdg-run/skvm --env="XDG_RUNTIME_DIR=$TEST_VM_LIBVIRT_RUNTIME_DIR")
fi
command_name="$1"
shift
run_on_host flatpak run "${flatpak_args[@]}" --command="$command_name" org.virt_manager.virt-manager "$@"
