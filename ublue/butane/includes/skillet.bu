variant: fcos
version: 1.6.0
storage:
  directories:
    - path: /var/lib/skillet
      mode: 0755
  files:
    - path: /var/lib/skillet/skillet-clamps
      mode: 0755
      contents:
        local: files/skillet-clamps
systemd:
  units:
    - name: skillet-apply.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply Skillet clamps base configuration
        Requires=clamps-bootstrap.service
        After=clamps-bootstrap.service
        ConditionPathExists=/run/clamps-bootstrap-ready

        [Service]
        Type=oneshot
        ExecStart=/var/lib/skillet/skillet-clamps apply --phase base
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
