variant: fcos
version: 1.6.0
storage:
  directories:
    - path: /var/lib/data
      mode: 0755
  files:
    - path: /etc/containers/storage.conf
      mode: 0644
      contents:
        inline: |
          [storage]
          driver = "overlay"
          runroot = "/run/containers/storage"
          graphroot = "/var/lib/data/containers/system"
    - path: /var/usrlocal/bin/skillet-data-top
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          [[ "$(findmnt -T /var -n -o FSTYPE)" == btrfs ]] || {
            echo '/var must be backed by Btrfs' >&2
            exit 1
          }
          var_uuid="$(findmnt -T /var -n -o UUID)"
          root_device=/dev/disk/by-partlabel/root
          [[ -n "$var_uuid" && "$(blkid -s UUID -o value "$root_device")" == "$var_uuid" ]] || {
            echo 'The root partition does not match the Btrfs filesystem backing /var' >&2
            exit 1
          }
          top="$(mktemp -d /run/skillet-data-top.XXXXXX)"
          cleanup() {
            mountpoint -q "$top" && umount "$top"
            rmdir "$top"
          }
          trap cleanup EXIT
          mount -t btrfs -o subvolid=5 "$root_device" "$top"
          if btrfs subvolume show "$top/data" >/dev/null 2>&1; then
            exit 0
          fi
          [[ ! -e "$top/data" ]] || {
            echo 'Top-level data path exists but is not a Btrfs subvolume' >&2
            exit 1
          }
          btrfs subvolume create "$top/data"
    - path: /var/usrlocal/bin/skillet-data-prepare
      mode: 0755
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail
          mountpoint -q /var/lib/data || {
            echo '/var/lib/data is not mounted' >&2
            exit 1
          }
          [[ "$(findmnt -M /var/lib/data -n -o FSTYPE)" == btrfs &&
             "$(findmnt -M /var/lib/data -n -o FSROOT)" == /data &&
             "$(findmnt -M /var/lib/data -n -o UUID)" == "$(findmnt -M /var -n -o UUID)" ]] || {
            echo '/var/lib/data is not the data subvolume of the /var Btrfs filesystem' >&2
            exit 1
          }
          if ! btrfs subvolume show /var/lib/data/containers >/dev/null 2>&1; then
            [[ ! -e /var/lib/data/containers ]] || {
              echo 'Container path exists but is not a Btrfs subvolume' >&2
              exit 1
            }
            btrfs subvolume create /var/lib/data/containers
          fi
          mkdir -p /var/lib/data/containers/system
          if ! semanage fcontext -l -C | grep -Fq '/var/lib/data/containers/system'; then
            semanage fcontext -a -e /var/lib/containers/storage /var/lib/data/containers/system
            restorecon -R /var/lib/data/containers/system
          fi
          restorecon /var/lib/data/containers/system
systemd:
  units:
    - name: skillet-data-top.service
      contents: |
        [Unit]
        Description=Create the shared Btrfs data subvolume
        DefaultDependencies=no
        Requires=var.mount
        After=var.mount
        Before=var-lib-data.mount

        [Service]
        Type=oneshot
        ExecStart=/var/usrlocal/bin/skillet-data-top
        RemainAfterExit=yes
    - name: var-lib-data.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount the shared Btrfs service data subvolume
        Requires=skillet-data-top.service
        After=skillet-data-top.service

        [Mount]
        What=/dev/disk/by-partlabel/root
        Where=/var/lib/data
        Type=btrfs
        Options=subvol=data,noatime,compress=zstd:3

        [Install]
        WantedBy=multi-user.target
    - name: skillet-data-prepare.service
      enabled: true
      contents: |
        [Unit]
        Description=Prepare shared Podman storage on the data mount
        Requires=var-lib-data.mount
        After=var-lib-data.mount
        Requires=ucore-bootstrap.service
        After=ucore-bootstrap.service
        ConditionPathExists=/run/ucore-bootstrap-ready
        AssertPathIsMountPoint=/var/lib/data

        [Service]
        Type=oneshot
        ExecStart=/var/usrlocal/bin/skillet-data-prepare
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    - name: podman-auto-update.service
      dropins:
        - name: 10-skillet-data.conf
          contents: |
            [Unit]
            Requires=skillet-data-prepare.service
            After=skillet-data-prepare.service
            AssertPathIsMountPoint=/var/lib/data
