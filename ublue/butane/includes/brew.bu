variant: fcos
version: 1.6.0
storage:
  directories:
    - path: /home/linuxbrew
      mode: 0755
      user:
        name: giacomo
      group:
        name: giacomo
    - path: /home/giacomo/.local
      mode: 0750
      user:
        name: giacomo
      group:
        name: giacomo
    - path: /home/giacomo/.local/src
      mode: 0750
      user:
        name: giacomo
      group:
        name: giacomo
systemd:
  units:
    - name: brew-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install Homebrew
        Requires=ucore-bootstrap.service
        After=ucore-bootstrap.service network-online.target
        Wants=network-online.target
        ConditionPathExists=/run/ucore-bootstrap-ready
        ConditionPathExists=!/var/lib/ucore-bootstrap/brew-installed

        [Service]
        Type=oneshot
        StandardOutput=journal+console
        User=giacomo
        Environment="NONINTERACTIVE=1"
        ExecStart=curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o /tmp/install_brew.sh
        ExecStart=/bin/bash /tmp/install_brew.sh
        ExecStartPost=+/usr/bin/touch /var/lib/ucore-bootstrap/brew-installed
        TimeoutStartSec=30min

        [Install]
        WantedBy=multi-user.target
    - name: dotfiles-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install dotfiles
        Requires=ucore-bootstrap.service brew-install.service
        After=ucore-bootstrap.service brew-install.service
        Wants=network-online.target
        ConditionPathExists=/run/ucore-bootstrap-ready
        ConditionPathExists=!/var/lib/ucore-bootstrap/dotfiles-installed

        [Service]
        Type=oneshot
        User=giacomo
        StandardOutput=journal+console
        WorkingDirectory=/home/giacomo/.local/src
        Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
        ExecStart=/usr/bin/bash -c 'if ! test -d /home/giacomo/.local/src/dotfiles/.git; then git clone https://github.com/gbagnoli/dotfiles.git /home/giacomo/.local/src/dotfiles; fi'
        ExecStart=/bin/bash /home/giacomo/.local/src/dotfiles/install.sh -b core -V
        ExecStartPost=+/usr/bin/touch /var/lib/ucore-bootstrap/dotfiles-installed
        TimeoutStartSec=30min

        [Install]
        WantedBy=multi-user.target
