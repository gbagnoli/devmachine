variant: fcos
version: 1.6.0
storage:
  files:
    - path: /var/usrlocal/bin/skillet-clamps
      mode: 0755
      contents:
        local: files/skillet-clamps
systemd:
  units:
    - name: skillet-apply.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply Skillet clamps base configuration
        Requires=ucore-bootstrap.service
        After=ucore-bootstrap.service
        ConditionPathExists=/run/ucore-bootstrap-ready

        [Service]
        Type=oneshot
        ExecStart=/var/usrlocal/bin/skillet-clamps apply --phase base

        [Install]
        WantedBy=multi-user.target
    - name: skillet-full-apply.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply Skillet clamps application configuration
        Requires=skillet-apply.service
        After=skillet-apply.service
        Requires=skillet-data-prepare.service
        After=skillet-data-prepare.service
        AssertPathIsMountPoint=/var/lib/data
        ConditionPathExists=/etc/credstore.encrypted/skillet/pihole_web_password.cred
        ConditionPathExists=/etc/credstore.encrypted/skillet/tailscale_auth_key.cred

        [Service]
        Type=oneshot
        LoadCredentialEncrypted=pihole_web_password:/etc/credstore.encrypted/skillet/pihole_web_password.cred
        LoadCredentialEncrypted=tailscale_auth_key:/etc/credstore.encrypted/skillet/tailscale_auth_key.cred
        ExecStart=/var/usrlocal/bin/skillet-clamps apply --phase full

        [Install]
        WantedBy=multi-user.target
    - name: skillet-caddy-apply.service
      enabled: true
      contents: |
        [Unit]
        Description=Apply Skillet Caddy private UI configuration
        Requires=skillet-full-apply.service
        After=skillet-full-apply.service
        Requires=skillet-data-prepare.service
        After=skillet-data-prepare.service
        AssertPathIsMountPoint=/var/lib/data
        ConditionPathExists=/etc/credstore.encrypted/skillet/caddy_sites.cred
        ConditionPathExists=/etc/credstore.encrypted/skillet/cloudflare_acme_token.cred

        [Service]
        Type=oneshot
        LoadCredentialEncrypted=caddy_sites:/etc/credstore.encrypted/skillet/caddy_sites.cred
        LoadCredentialEncrypted=cloudflare_acme_token:/etc/credstore.encrypted/skillet/cloudflare_acme_token.cred
        ExecStart=/var/usrlocal/bin/skillet-clamps apply --phase caddy

        [Install]
        WantedBy=multi-user.target
