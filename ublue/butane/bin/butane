#!/usr/bin/env bash
set -euo pipefail

script_dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
butane_dir="$(realpath "$script_dir/..")"
repo_dir="$(realpath "$butane_dir/..")"

usage() {
  echo "Usage: $0 [-s] [-o OUTPUT_DIR] CONFIG.bu [CONFIG.ign]" >&2
}

save=false
output_dir="$(realpath -m "$butane_dir/ignition")"
while getopts ':hso:' option; do
  case "$option" in
    h) usage; exit 0 ;;
    s) save=true ;;
    o) output_dir="$(realpath -m "$OPTARG")" ;;
    *) usage; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -ge 1 && $# -le 2 && "$1" == *.bu && -f "$1" ]] || { usage; exit 2; }

input="$(realpath "$1")"
output_name="${2:-$(basename "${input%.bu}.ign")}"
[[ "$output_name" != */* && "$output_name" == *.ign ]] || { echo "Output must be a .ign filename" >&2; exit 2; }
mkdir -p "$output_dir"
work_dir="$(mktemp -d "$output_dir/.butane.XXXXXXXX")"
trap 'rm -rf -- "$work_dir"' EXIT

# Local merge sources are compiled first. Their Ignition paths stay relative to
# --files-dir, which is this isolated workspace rather than the source tree.
mapfile -t fragments < <(yq -r '.ignition.config.merge[].local' "$input")
for fragment in "${fragments[@]}"; do
  [[ "$fragment" == *.bu && "$fragment" != /* && "$fragment" != *..* ]] || {
    echo "Unsupported merge source: $fragment" >&2; exit 2;
  }
  mkdir -p "$work_dir/$(dirname "$fragment")"
  cp "$(dirname "$input")/$fragment" "$work_dir/$fragment"
done
cp "$input" "$work_dir/input.bu"
if [[ -d "$(dirname "$input")/files" ]]; then
  cp -a "$(dirname "$input")/files" "$work_dir/files"
fi

# Host configs include the generic CLI and a host-specific credential CLI.
# VM provisioning stages freshly built artifacts for VM-only Ignition; physical
# host compilation builds them here when callers have not staged binaries.
if rg -q -F 'includes/skillet.bu' "$input"; then
  host="$(basename "$input" .bu)"
  generic_artifact="$work_dir/files/skillet"
  host_artifact="$work_dir/files/skillet-$host"
  if [[ ! -x "$generic_artifact" || ! -x "$host_artifact" ]]; then
    artifact_target_dir="${CARGO_TARGET_DIR:-$repo_dir/skillet/target}"
    if [[ "$artifact_target_dir" != /* ]]; then artifact_target_dir="$repo_dir/skillet/$artifact_target_dir"; fi
    (cd "$repo_dir/skillet" && cargo build --release --target x86_64-unknown-linux-musl -p skillet -p "skillet-$host")
    mkdir -p "$work_dir/files"
    cp "$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet" "$generic_artifact"
    cp "$artifact_target_dir/x86_64-unknown-linux-musl/release/skillet-$host" "$host_artifact"
    chmod 0755 "$generic_artifact" "$host_artifact"
  fi
fi

run_butane() {
  podman run --interactive --rm --security-opt label=disable \
    --volume "$work_dir:/work" --workdir /work quay.io/coreos/butane:release \
    --pretty --strict --files-dir /work "$1"
}

for fragment in "${fragments[@]}"; do
  compiled="${fragment%.bu}.ign"
  run_butane "$fragment" > "$work_dir/$compiled"
  FRAGMENT="$fragment" COMPILED="$compiled" yq -i \
    '(.ignition.config.merge[] | select(.local == strenv(FRAGMENT)) | .local) = strenv(COMPILED)' \
    "$work_dir/input.bu"
done

if "$save"; then
  run_butane input.bu > "$output_dir/$output_name"
  echo "$output_dir/$output_name"
else
  run_butane input.bu
fi
